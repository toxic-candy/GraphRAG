# =====================================================================
# Medical GraphRAG Environment Configuration
# =====================================================================

# ---------------------------------------------------------------------
# 1. Groq API Key (Free Tier)
# Get your free API key at: https://console.groq.com/keys
# ---------------------------------------------------------------------
GROQ_API_KEY=your_groq_api_key_here

# Groq OpenAI-compatible API Endpoint
OPENAI_API_BASE_URL=https://api.groq.com/openai/v1

# Groq Model Selection
# Recommended high-performance free models:
#   - llama-3.3-70b-versatile (Recommended for medical reasoning & extraction)
#   - llama-3.1-8b-instant (Fastest, ultra-low latency)
GROQ_MODEL=llama-3.3-70b-versatile
OPENAI_MODEL=llama-3.3-70b-versatile

# ---------------------------------------------------------------------
# 2. Pipeline Execution Flags
# 1 = Enable LLM feature, 0 = Use local deterministic fallback
# ---------------------------------------------------------------------
USE_LLM_EXTRACTION=0
USE_LLM_SUMMARY=0
USE_LLM_ANSWER=1
USE_REMOTE_EMBEDDINGS=0

# ---------------------------------------------------------------------
# 3. Neo4j Graph Database
# ---------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=test1234
