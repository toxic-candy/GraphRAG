# =====================================================================
# Medical GraphRAG — Environment Configuration
# Copy this file to .env and fill in your credentials.
# NEVER commit .env to version control.
# =====================================================================

# ---------------------------------------------------------------------
# 1. Local Ollama Settings
# ---------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_EXTRACTION_MODEL=llama3:8b
OLLAMA_SUMMARY_MODEL=llama3:8b
OLLAMA_ANSWER_MODEL=qwen3:14b
OLLAMA_EMBEDDING_MODEL=nomic-embed-text

# ---------------------------------------------------------------------
# 2. Pipeline Execution Flags
# 1 = Enable LLM feature, 0 = Use local deterministic fallback
# ---------------------------------------------------------------------
USE_LLM_EXTRACTION=0   # Graph extraction:  0=rule-based fallback, 1=llama3:8b
USE_LLM_SUMMARY=0      # Chunk summarisation: 0=local truncation, 1=llama3:8b
USE_LLM_ANSWER=1       # Final answers:  0=local text, 1=qwen3:14b
USE_REMOTE_EMBEDDINGS=0  # 0=SHA-256 hash fallback, 1=nomic-embed-text

# ---------------------------------------------------------------------
# 3. Neo4j Graph Database
# ---------------------------------------------------------------------
NEO4J_URI=bolt://localhost:7687
NEO4J_URL=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
